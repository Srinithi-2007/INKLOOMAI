# INKLOOMAI Backend Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Used by the local Express listener; Vercel handles requests without app.listen().
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inkloom?retryWrites=true&w=majority

# JWT secret for signing session tokens (use a long random string)
JWT_SECRET=replace-with-a-strong-random-secret

# Gemini API key for AI compliance review
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# TASK 1: PERSISTENT CLOUD OBJECT STORAGE (Vercel Production Compatible)
# Provider options: 'cloudinary' | 's3' | 'local'
# Default fallback: local disk storage at backend/uploads/
# ==============================================================================
STORAGE_PROVIDER=cloudinary

# Cloudinary Option (Recommended for media, image uploads, and brand assets)
# Configure via standard URL:
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Or configure via individual keys:
# CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AWS S3 Option (Alternative cloud object storage)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_S3_BUCKET=your-s3-bucket-name
# AWS_REGION=us-east-1

# ==============================================================================
# TASK 2: PRODUCTION-COMPATIBLE NOTIFICATIONS (Vercel Serverless Compatible)
# Provider options: 'pusher' | 'local-sse'
# Replaces ephemeral single-process SSE with multi-instance serverless event delivery.
# Default fallback: local in-memory SSE pool with 30s background polling fallback.
# ==============================================================================
NOTIFICATION_PROVIDER=pusher
PUSHER_APP_ID=your-pusher-app-id
PUSHER_KEY=your-pusher-app-key
PUSHER_SECRET=your-pusher-app-secret
PUSHER_CLUSTER=mt1
