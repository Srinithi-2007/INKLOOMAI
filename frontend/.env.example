# INKLOOMAI Frontend Environment Variables
# Copy to .env.local for local overrides.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Pusher Channels Public Client Configuration (Optional - for real-time edge updates)
# SECURITY NOTICE: Never put PUSHER_SECRET here.
NEXT_PUBLIC_PUSHER_KEY=your-pusher-app-key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1
